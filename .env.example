# Backend Environment Variables
PORT=5000
NODE_ENV=development

# Database
# Local development:
MONGODB_URI=mongodb://localhost:27017/downloadanyvideo

# Production / business plan deployment:
# Use a remote MongoDB URI, for example MongoDB Atlas.
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/downloadanyvideo?retryWrites=true&w=majority
MONGODB_DB_NAME=downloadanyvideo
MONGODB_MAX_POOL_SIZE=10

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
RATE_LIMIT_MAX=60

# Secret used to hash IPs and URLs before they are stored. REQUIRED in
# production and must be at least 32 characters; the server refuses to start
# without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HASH_SECRET=

# Number of reverse proxies in front of the backend. Use 0 when the app is
# exposed directly, otherwise a client can forge X-Forwarded-For and bypass
# rate limiting.
TRUST_PROXY=1

# Frontend build setting for split frontend/backend deployments.
# Use /api when the frontend and backend share one domain with a reverse proxy.
VITE_API_URL=/api

# Optional: yt-dlp path
YT_DLP_PATH=/usr/local/bin/yt-dlp

# Optional: Redis (for caching)
REDIS_URL=redis://localhost:6379

# Analytics
GOOGLE_ANALYTICS_ID=G_YOUR_ID

# Email (for DMCA)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Admin Email
ADMIN_EMAIL=admin@downloadanyvideo.com
